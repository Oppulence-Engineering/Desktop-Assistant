# EditorConfig — https://editorconfig.org
# Repo-wide baseline so editors agree on whitespace before Prettier/gofmt run.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is tab-indented (gofmt).
[*.go]
indent_style = tab

# Makefiles require real tabs.
[Makefile]
indent_style = tab

[*.{mk,mak}]
indent_style = tab

# Don't strip trailing whitespace in Markdown (it's a hard line break).
[*.md]
trim_trailing_whitespace = false
