# rowboat-api configuration. All values have dev defaults; copy to .env for
# local overrides. See internal/appconfig/config.go for the full surface.

# --- Service / network ---
SERVICE_NAME=rowboat-api
ENVIRONMENT=development          # production | staging | development
HTTP_ADDR=:8080
METRICS_ADDR=:9090
GRPC_ADDR=:8081
LOG_LEVEL=info                   # debug | info | warn | error

# --- Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # empty disables span export

# --- Persistence ---
# Empty DATABASE_URL → local sqlite file (dev). Postgres in prod:
# DATABASE_URL=postgres://user:pass@host:5432/rowboat?sslmode=require
# REDIS_URL=redis://localhost:6379/0                  # empty → in-memory rate limiter
AUTO_MIGRATE=true
DB_ENCRYPTION_KEY=dev-insecure-encryption-key-change-me

# --- Public /v1/config (served to the desktop) ---
APP_URL=https://app.solomon-ai.co
OIDC_ISSUER_URL=https://oauth.solomon-ai.co
WEBSOCKET_API_URL=
# OAUTH_CLIENT_ID=rowboat-desktop  # set → desktop uses a static OIDC client (else DCR)

# --- Token verification (rowboat-api is a resource server) ---
TOKEN_ISSUER=https://oauth.solomon-ai.co
TOKEN_AUDIENCE=rowboat-api
JWKS_URL=https://oauth.solomon-ai.co/.well-known/jwks.json

# --- WorkOS (user enrichment) ---
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# --- Ory connector brokering ---
ORY_PUBLIC_URL=https://oauth.solomon-ai.co
# ORY_BROKER_CLIENT_ID=rowboat-connector-broker
# ORY_BROKER_CLIENT_SECRET=
PUBLIC_BASE_URL=https://api.x.solomon-ai.co
DESKTOP_DEEPLINK_SCHEME=rowboat

# --- Webhook / internal shared secrets ---
# HOOK_HMAC_SECRET=                # /oauth-hooks/* signature
# INTERNAL_API_SECRET=             # /v1/internal/* shared secret

# --- Infisical (vendor key pool); when disabled, vendor keys come from env ---
INFISICAL_ENABLED=false
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_TOKEN=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=dev

# --- Vendor keys (env fallback for local dev) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# ELEVENLABS_API_KEY=
# EXA_API_KEY=
# COMPOSIO_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Billing / pricing ---
FREE_TIER_CREDITS=10000
# PRICING_JSON={"exaPerQuery":50}   # overrides the default pricing table
# CONNECTORS_JSON=[...]             # overrides the default connector registry
