{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mts,mjs}",
    "e2e/fake-rowboat-api.mjs",
    "e2e/auth.setup.ts",
    "e2e-stack/**/*.spec.ts",
    ".storybook/**/*.{ts,tsx}",
    "stories/**/*.{ts,tsx}",
    "components/**/*.stories.{ts,tsx}",
    "app/**/*.stories.{ts,tsx}",
    "quality/**/*.{ts,tsx}",
    "*.config.{ts,mjs}",
    "config/**/*.{ts,mts}",
    "instrumentation.ts"
  ],
  "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}", "!lib/api/generated/**"],
  "ignoreFiles": [
    "components/ai-elements/canvas.tsx",
    "components/ai-elements/chain-of-thought.tsx",
    "components/ai-elements/checkpoint.tsx",
    "components/ai-elements/confirmation.tsx",
    "components/ai-elements/connection.tsx",
    "components/ai-elements/context.tsx",
    "components/ai-elements/controls.tsx",
    "components/ai-elements/edge.tsx",
    "components/ai-elements/image.tsx",
    "components/ai-elements/inline-citation.tsx",
    "components/ai-elements/loader.tsx",
    "components/ai-elements/model-selector.tsx",
    "components/ai-elements/node.tsx",
    "components/ai-elements/open-in-chat.tsx",
    "components/ai-elements/panel.tsx",
    "components/ai-elements/plan.tsx",
    "components/ai-elements/queue.tsx",
    "components/ai-elements/sources.tsx",
    "components/ai-elements/suggestion.tsx",
    "components/ai-elements/task.tsx",
    "components/ai-elements/toolbar.tsx",
    "components/ai-elements/web-preview.tsx",
    "hooks/use-mobile.ts",
    "lib/icon.tsx",
    "lib/api/generated/**",
    "quality/fixtures/**",
    ".rowboat-contracts-*/**"
  ],
  "ignoreIssues": {
    "components/ai-elements/{code-block,conversation,message,prompt-input,reasoning}.tsx": [
      "exports",
      "types"
    ],
    "lib/{actions,cloud-workflows,revenue,metadata,product-navigation,dashboard-resource,dashboard-schemas,agent-history}.ts": [
      "exports",
      "types"
    ],
    "lib/icons.tsx": ["exports", "types"],
    "lib/connectors/hosted-oauth.ts": ["exports", "types"],
    "lib/content/editorial.ts": ["exports", "types"],
    "lib/agents/agent-schemas.ts": ["exports", "types"],
    "lib/api/**": ["exports", "types"],
    "hooks/queries/**": ["exports", "types"],
    "lib/auth/{proxy,pkce}.ts": ["exports", "types"],
    "lib/dev/{debug-bundle,route-catalog}.ts": ["exports", "types"],
    "components/revenue/shared.tsx": ["exports", "types"],
    "components/features/dashboard/chat-route-provider/chat-route-provider.tsx": [
      "exports",
      "types"
    ],
    "types/{actions,revenue}.ts": ["exports", "types"]
  },
  "ignoreDependencies": [
    "@emotion/react",
    "@emotion/styled",
    "@mui/icons-material",
    "@mui/material",
    "@radix-ui/react-use-controllable-state",
    "@radix-ui/react-avatar",
    "@radix-ui/react-collapsible",
    "@radix-ui/react-dialog",
    "@radix-ui/react-dropdown-menu",
    "@radix-ui/react-hover-card",
    "@radix-ui/react-progress",
    "@radix-ui/react-scroll-area",
    "@radix-ui/react-select",
    "@radix-ui/react-separator",
    "@radix-ui/react-slot",
    "@radix-ui/react-tooltip",
    "@eslint/eslintrc",
    "@faker-js/faker",
    "@vitest/coverage-v8",
    "@axe-core/react",
    "@base-ui/react",
    "@hookform/resolvers",
    "@shadcn/react",
    "@storybook/react",
    "axe-core",
    "class-variance-authority",
    "cmdk",
    "date-fns",
    "embla-carousel-react",
    "fumadocs-ui",
    "input-otp",
    "msw",
    "radix-ui",
    "react-day-picker",
    "react-hook-form",
    "react-resizable-panels",
    "recharts",
    "vaul",
    "server-only",
    "shadcn",
    "tailwindcss",
    "tokenlens",
    "tw-animate-css",
    "v0-sdk",
    "zustand",
    "plop"
  ],
  "ignoreBinaries": ["go", "pipx", "psql", "semgrep", "sqlite3"]
}
