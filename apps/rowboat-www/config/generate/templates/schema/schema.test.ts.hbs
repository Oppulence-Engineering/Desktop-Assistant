import { describe, expect, it } from "vitest";

import { {{schemaName}} } from "./{{name}}.schema";

describe("{{schemaName}}", () => {
  it("parses the generated domain props", () => {
    const parsed = {{schemaName}}.safeParse({
{{#each fields}}
      {{name}}: {{sample}},
{{/each}}
    });
    expect(parsed.success).toBe(true);
  });

  it("rejects an empty payload when fields are required", () => {
    if ({{hasFields}}) {
      expect({{schemaName}}.safeParse({}).success).toBe(false);
    } else {
      expect({{schemaName}}.safeParse({}).success).toBe(true);
    }
  });
});
