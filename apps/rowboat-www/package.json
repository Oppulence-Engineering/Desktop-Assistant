{
  "name": "rowboat-www",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "arch": "depcruise app components hooks lib ../../packages/ui/src --config config/architecture/dependency-cruiser.config.mjs --output-type err-long",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "component:new": "tsx scripts/generate-component.ts",
    "contracts:check": "node scripts/check-generated-contracts.mjs",
    "contracts:generate": "orval --config config/contracts/orval.config.ts",
    "format": "prettier --write . ../../packages/eslint-plugin-oppulence-web",
    "format:check": "prettier --check . ../../packages/eslint-plugin-oppulence-web",
    "knip": "knip --config config/quality/knip.json",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "lint": "eslint .",
    "security:gitleaks": "node scripts/run-gitleaks.mjs",
    "security:osv": "go run github.com/google/osv-scanner/v2/cmd/osv-scanner@v2.5.1 scan source .",
    "security:semgrep": "pipx run --spec semgrep==1.174.0 semgrep scan --config config/quality/semgrep.yml --error --metrics=off --no-git-ignore --exclude=node_modules --exclude=.next --exclude='lib/api/generated/**' --exclude='.rowboat-contracts-*' .",
    "seed:demo": "tsx scripts/seed-demo-workspace.ts",
    "screenshots:capture": "tsx scripts/capture-marketing-screenshots.ts",
    "test": "vitest run",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "ui:add": "node scripts/add-ui-component.mjs",
    "verify": "node scripts/run-verify.mjs default",
    "verify:ci": "node scripts/run-verify.mjs ci",
    "verify:fast": "node scripts/run-verify.mjs fast"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@oppulence/relationship-contract": "file:../../packages/relationship-contract",
    "@oppulence/ui": "file:../../packages/ui",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.1",
    "@tiptap/extension-link": "^3.31.1",
    "@tiptap/extension-placeholder": "^3.31.1",
    "@tiptap/pm": "^3.31.1",
    "@tiptap/react": "^3.31.1",
    "@tiptap/starter-kit": "^3.31.1",
    "@xyflow/react": "^12.10.0",
    "ai": "^7.0.73",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lowlight": "^3.3.0",
    "marked": "^17.0.1",
    "motion": "^12.23.25",
    "nanoid": "^5.1.6",
    "next": "^16.3.0",
    "platejs": "^53.3.11",
    "posthog-js": "^1.407.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^3.19.0",
    "streamdown": "^1.6.10",
    "tailwind-merge": "^3.4.0",
    "tokenlens": "^1.3.1",
    "turndown": "^7.2.2",
    "use-stick-to-bottom": "^1.1.1",
    "v0-sdk": "^0.15.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "^16.3.1",
    "@oppulence/eslint-plugin-web": "file:../../packages/eslint-plugin-oppulence-web",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "chrome-launcher": "^1.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "30.0.1",
    "knip": "^6.32.2",
    "lighthouse": "^13.4.1",
    "msw": "^2.15.0",
    "orval": "^8.24.0",
    "prettier": "^3.9.6",
    "shadcn": "4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "undici": "6.28.0"
  }
}
