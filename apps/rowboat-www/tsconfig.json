{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/.source": ["./.source/server.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@oppulence/ui/components": ["../../packages/ui/src/components"],
      "@oppulence/ui/components/*": ["../../packages/ui/src/components/*"],
      "@oppulence/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@oppulence/ui/lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "@oppulence/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "#lib/*": ["../../packages/ui/src/lib/*"],
      "#lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "#lib/icons": ["../../packages/ui/src/lib/icons.tsx"],
      "#components/*": ["../../packages/ui/src/components/*"],
      "@base-ui/react": ["./node_modules/@base-ui/react"],
      "@hookform/resolvers": ["./node_modules/@hookform/resolvers"],
      "@phosphor-icons/react": ["./node_modules/@phosphor-icons/react"],
      "@shadcn/react": ["./node_modules/@shadcn/react"],
      "class-variance-authority": ["./node_modules/class-variance-authority"],
      "clsx": ["./node_modules/clsx"],
      "cmdk": ["./node_modules/cmdk"],
      "date-fns": ["./node_modules/date-fns"],
      "embla-carousel-react": ["./node_modules/embla-carousel-react"],
      "input-otp": ["./node_modules/input-otp"],
      "next-themes": ["./node_modules/next-themes"],
      "radix-ui": ["./node_modules/radix-ui"],
      "react-day-picker": ["./node_modules/react-day-picker"],
      "react-hook-form": ["./node_modules/react-hook-form"],
      "react-resizable-panels": ["./node_modules/react-resizable-panels"],
      "recharts": ["./node_modules/recharts"],
      "sonner": ["./node_modules/sonner"],
      "tailwind-merge": ["./node_modules/tailwind-merge"],
      "vaul": ["./node_modules/vaul"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".source/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../../packages/ui/node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "stories"
  ]
}
