# rowboat-www — copy to .env.local for local development.
# WorkOS credentials live in rowboat-api (see apps/rowboat-api/.env.example).

# Required in production; dev fallback is set in scripts/dev-local.sh
ROWBOAT_WWW_SESSION_SECRET=dev-only-rowboat-www-session-secret-change-me

# BFF upstream (rowboat-api). dev:local defaults to http://localhost:18080
ROWBOAT_WWW_API_PROXY_URL=http://localhost:18080
ROWBOAT_WWW_PUBLIC_API_BASE_URL=http://localhost:18080
ROWBOAT_WWW_AUTH_API_BASE_URL=http://localhost:18080

# Canonical origin for redirects and sealed cookies
ROWBOAT_WWW_PUBLIC_APP_URL=http://localhost:18082

# Optional: skip AuthKit provider picker (e.g. GoogleOAuth)
# ROWBOAT_WWW_WORKOS_PROVIDER=GoogleOAuth

# Optional: Plain support chat (disabled in dev unless ROWBOAT_WWW_PLAIN_CHAT_ENABLED=1)
# ROWBOAT_WWW_PLAIN_CHAT_APP_ID=
# ROWBOAT_WWW_PLAIN_CHAT_SECRET=
# ROWBOAT_WWW_PLAIN_CHAT_ENABLED=1
# ROWBOAT_WWW_PLAIN_CHAT_IDENTIFY=1

# Optional: analytics (no-op when unset)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: metadata override for staging previews
# NEXT_PUBLIC_SITE_URL=https://oppulence.io

# Dev server port (npm run dev:local)
# ROWBOAT_WWW_PORT=18082
