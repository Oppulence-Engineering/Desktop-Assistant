{
  "name": "oauth-consent",
  "private": true,
  "version": "0.1.0",
  "description": "Ory Hydra login + consent UI federating to WorkOS, with rowboat-api entitlement gating.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
