{
  "name": "x",
  "private": true,
  "type": "module",
  "version": "0.1.30",
  "scripts": {
    "dev": "npm run deps && concurrently -k \"npm:renderer\" \"npm:main\"",
    "renderer": "cd apps/renderer && npm run dev",
    "shared": "cd packages/shared && npm run build",
    "core": "cd packages/core && npm run build",
    "preload": "cd apps/preload && npm run build",
    "deps": "npm run shared && npm run core && npm run preload",
    "main": "wait-on http://localhost:5173 && cd apps/main && npm run build && npm run start",
    "start:dogfood": "cd apps/main && npm run start:dogfood",
    "test": "npm run shared && npm run test:architecture-contracts && npm run test:graph-cache && npm run test:meeting-readiness && npm run test:user-facing-errors && npm run test:service-error-copy && npm run test:preview-text && npm run test:billing-flow && npm run test:session-reconnect && npm run test:desktop-dictation && npm run test:product-tour && cd packages/core && npm test",
    "test:architecture-contracts": "node --experimental-strip-types --test tests/external-url.test.ts tests/ipc-security.test.ts tests/renderer-events.test.ts",
    "test:graph-cache": "node --experimental-strip-types --test tests/knowledge-graph-cache.test.ts",
    "test:meeting-readiness": "node --experimental-strip-types --test tests/meeting-readiness.test.ts",
    "test:user-facing-errors": "node --experimental-strip-types --test tests/user-facing-error.test.ts",
    "test:service-error-copy": "node --experimental-strip-types --test tests/service-error-copy.test.ts",
    "test:preview-text": "node --experimental-strip-types --test tests/preview-text.test.ts",
    "test:billing-flow": "node --experimental-strip-types --test tests/billing-flow.test.ts",
    "test:session-reconnect": "node --experimental-strip-types --test tests/session-reconnect.test.ts",
    "test:desktop-dictation": "node --experimental-strip-types --test tests/desktop-dictation.test.ts",
    "test:product-tour": "node --experimental-strip-types --test tests/product-tour-state.test.ts tests/product-tour-targets.test.ts",
    "typecheck": "npm run deps && cd apps/renderer && tsc -b",
    "check:types": "npm run deps && cd apps/renderer && npm run build && cd ../main && npm run build",
    "security:electron": "node scripts/electron-security-check.mjs",
    "fuses:verify": "node tools/electron-security/verify-fuses.mjs",
    "diarize:fixtures": "npm run core && node scripts/diarize-fixtures.mjs",
    "quality": "npm run verify:ci",
    "architecture:plugin": "pnpm --filter @x/eslint-plugin-x-architecture build",
    "architecture:plugin:test": "pnpm --filter @x/eslint-plugin-x-architecture test",
    "architecture": "dependency-cruise --config config/dependency-cruiser.config.mjs --ignore-known config/baselines/dependency-cruiser-known-violations.json apps packages tests scripts tools",
    "architecture:dependencies:update": "depcruise-baseline --config config/dependency-cruiser.config.mjs --output-to config/baselines/dependency-cruiser-known-violations.json apps packages tests scripts tools",
    "architecture:baseline": "node tools/architecture/update-baseline.mjs",
    "architecture:baseline:update": "node tools/architecture/update-baseline.mjs --write",
    "ast-grep": "ast-grep scan --config config/sgconfig.yml",
    "semgrep": "node scripts/run-external-check.mjs semgrep --config rules/semgrep --error --metrics=off apps packages scripts",
    "knip": "node tools/architecture/knip-ratchet.mjs",
    "knip:baseline:update": "node tools/architecture/knip-ratchet.mjs --write",
    "packages:check": "npm run deps && publint packages/shared && publint packages/core && attw --pack --profile esm-only packages/shared && attw --pack --profile esm-only packages/core",
    "policy": "node scripts/run-external-check.mjs conftest test package.json apps/main/package.json packages/core/package.json packages/shared/package.json --policy policy",
    "secrets": "node scripts/run-external-check.mjs gitleaks dir --redact --no-banner .",
    "deps:audit": "node scripts/run-external-check.mjs osv-scanner scan --config=config/osv-scanner.toml --lockfile=pnpm-lock.yaml",
    "format:check": "node tools/architecture/prettier-ratchet.mjs",
    "format:baseline:update": "node tools/architecture/prettier-ratchet.mjs --write",
    "verify": "npm run format:check && npm run architecture:plugin && npm run architecture:plugin:test && npm run lint && npm run architecture && npm run architecture:baseline && npm run ast-grep && npm run semgrep && npm run knip && npm run security:electron && npm run packages:check && npm run check:types && npm test && npm run policy && npm run secrets && npm run deps:audit",
    "verify:ci": "X_GAUNTLET_REQUIRE_EXTERNAL=1 npm run verify",
    "lint": "npm run architecture:plugin && pnpm run lint:main && pnpm run lint:preload && pnpm run lint:renderer && pnpm run lint:core && pnpm run lint:shared && pnpm run lint:plugin",
    "lint:main": "eslint --config config/eslint.config.mts apps/main --quiet",
    "lint:preload": "eslint --config config/eslint.config.mts apps/preload --quiet",
    "lint:renderer": "eslint --config config/eslint.config.mts apps/renderer --quiet",
    "lint:core": "NODE_OPTIONS=--max-old-space-size=8192 eslint --config config/eslint.config.mts packages/core --quiet",
    "lint:shared": "eslint --config config/eslint.config.mts packages/shared --quiet",
    "lint:plugin": "eslint --config config/eslint.config.mts packages/eslint-plugin-x-architecture --quiet",
    "lint:fix": "npm run architecture:plugin && eslint --config config/eslint.config.mts apps packages --fix"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ast-grep/cli": "^0.45.1",
    "@electron/fuses": "^2.1.3",
    "@x/eslint-plugin-x-architecture": "workspace:*",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "knip": "^6.32.2",
    "prettier": "^3.6.2",
    "publint": "^0.3.24",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "wait-on": "^9.0.3"
  },
  "pnpm": {
    "overrides": {
      "@protobufjs/utf8@<=1.1.0": "1.1.1",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "@modelcontextprotocol/sdk>ajv": "8.20.0",
      "@hono/node-server@<2.0.10": "2.0.10",
      "axios@>=1.0.0 <1.18.0": "1.18.0",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "adm-zip@<0.6.0": "0.6.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <3.0.6": "3.0.6",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "dompurify@<=3.4.12": "3.4.13",
      "esbuild@<=0.24.2": "0.25.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri@<3.1.5": "3.1.5",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "gaxios@<7.1.4": "7.1.4",
      "hono@<4.12.34": "4.12.34",
      "ip-address@<10.3.1": "10.3.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "linkify-it@<=5.0.1": "5.0.2",
      "lodash@<=4.17.23": "4.18.1",
      "markdown-it@<=14.1.1": "14.2.0",
      "mermaid@>=11.0.0 <11.16.1": "11.16.1",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "path-to-regexp@>=8.0.0 <8.4.2": "8.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "nanoid@>=5.0.0 <5.1.16": "5.1.16",
      "postcss@<8.5.23": "8.5.23",
      "protobufjs@<=7.5.7": "7.6.1",
      "qs@<=6.14.1": "6.15.2",
      "rollup@>=4.0.0 <4.60.4": "4.60.4",
      "shell-quote@<=1.8.4": "1.9.0",
      "tar@<=7.5.20": "7.5.21",
      "tmp@<0.2.7": "0.2.7",
      "uuid@<11.1.1": "11.1.1",
      "vite@>=7.0.0 <=7.3.4": "7.3.5"
    }
  }
}
