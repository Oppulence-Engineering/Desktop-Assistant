# Production Canvas MCP example. Use one audience per deployment.
# rowboat-api mints these connector resource tokens. Hydra consent-plane tokens
# use a different issuer/JWKS and must never be accepted by a product MCP.
OAUTH_ISSUER=https://api.oppulence.io
OAUTH_JWKS_URL=https://api.oppulence.io/.well-known/connector-jwks.json
OAUTH_AUDIENCE=mcp:canvas
OAUTH_ALLOWED_ALGORITHMS=RS256
OAUTH_CLOCK_SKEW_SECONDS=60
OAUTH_JWKS_CACHE_TTL_SECONDS=300
OAUTH_JWKS_REFETCH_ON_KID_MISS=true
OAUTH_REQUIRED_SCOPES=canvas.read
OAUTH_CONNECTION_VALIDATION_MODE=live
OAUTH_REVOCATION_CHECK_URL=https://api.oppulence.io/v1/internal/connections/status
OAUTH_CONNECTION_STATUS_CHECK=every-request
OAUTH_CONNECTION_STATUS_FAILURE_POLICY=deny
OAUTH_DISCONNECT_ENFORCEMENT=immediate

# Staging must use a distinct issuer and audience:
# OAUTH_ISSUER=https://api.x.staging.oppulence.io
# OAUTH_JWKS_URL=https://api.x.staging.oppulence.io/.well-known/connector-jwks.json
# OAUTH_AUDIENCE=mcp:canvas-staging
