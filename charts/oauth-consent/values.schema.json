{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "deploymentEnvironment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "database": {
      "type": "object",
      "required": ["urlSecretKey"],
      "properties": {
        "urlSecretKey": { "const": "DATABASE_URL" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "hydraAdmin", "postgresql"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hydraAdmin": {
          "type": "object",
          "required": ["port", "namespaceSelector", "podSelector"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "namespaceSelector": { "$ref": "#/$defs/selector" },
            "podSelector": { "$ref": "#/$defs/selector" }
          }
        },
        "postgresql": {
          "type": "object",
          "required": ["port", "cidrs"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "cidrs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$",
                "not": { "enum": ["0.0.0.0/0", "10.0.0.10/32"] }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deploymentEnvironment": { "enum": ["staging", "production"] }
        },
        "required": ["deploymentEnvironment"]
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "enabled": { "const": true },
              "postgresql": {
                "properties": { "cidrs": { "minItems": 1 } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
